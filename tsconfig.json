{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    // Node 20 and newer understand ES2022 natively, so no downleveling is needed.
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // Required by the NestJS decorators in src/nest-decorator.ts.
    "experimentalDecorators": true
  },
  "include": ["src/**/*"]
}
